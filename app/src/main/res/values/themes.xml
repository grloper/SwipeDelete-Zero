<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Launch theme. The brand mark sits on the warm charcoal surface, so the
      first frame the user sees is already the app's world — no white flash,
      and no jump between splash and content because both use surface_0.
    -->
    <style name="Theme.SwipeDeleteZero.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SwipeDeleteZero</item>
    </style>

    <!--
      Host theme. Kept minimal: the full system lives in Compose
      (ui/theme/SdzTokens.kt). Bars are transparent because every screen draws
      edge-to-edge and insets its own chrome.
    -->
    <style name="Theme.SwipeDeleteZero" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/surface_0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
