<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-card video surface. surface_type MUST stay texture_view: the swipe card
  translates, rotates and corner-clips its content, and only a TextureView
  composites inside the view hierarchy (a SurfaceView punches an untransformed
  hole through it). The controller stays off — the card gestures are the UI.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="zoom"
    app:surface_type="texture_view"
    app:use_controller="false" />
