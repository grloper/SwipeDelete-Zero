<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-flavor-only overlay.

  This is the ONLY flavor that declares android.permission.INTERNET, used
  exclusively for the opt-in Google Drive backup of kept & starred files.
  The fdroid and play flavors keep the hard air-gap (zero network permissions).
  If you want the fully offline guarantee, install the fdroid APK instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
