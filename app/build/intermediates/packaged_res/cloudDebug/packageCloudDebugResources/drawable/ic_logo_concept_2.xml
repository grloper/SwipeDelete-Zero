    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- back frame -->
    <group android:pivotX="24" android:pivotY="24" android:rotation="-10">
        <path
            android:fillColor="#4A443D"
            android:pathData="M13,9 h22 a6,6 0 0 1 6,6 v18 a6,6 0 0 1 -6,6 h-22 a6,6 0 0 1 -6,-6 v-18 a6,6 0 0 1 6,-6 z" />
    </group>
    <!-- middle frame -->
    <group android:pivotX="24" android:pivotY="24" android:rotation="-5">
        <path
            android:fillColor="#8A8078"
            android:pathData="M13,8 h22 a6,6 0 0 1 6,6 v19 a6,6 0 0 1 -6,6 h-22 a6,6 0 0 1 -6,-6 v-19 a6,6 0 0 1 6,-6 z" />
    </group>
    <!-- top frame, mid-swipe, aperture cut as a zero -->
